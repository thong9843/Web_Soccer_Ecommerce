# Sao chép file này thành apps/api/.env (không commit file .env).

NODE_ENV=development
PORT=4000

# Database (Docker Compose hoặc `pnpm db:start`)
DATABASE_URL="postgresql://football:football@localhost:5432/football"

# JWT: đổi sang chuỗi ngẫu nhiên dài (>= 32 ký tự) khi deploy
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Số lớp proxy tin cậy trước API để lấy IP khách thật cho rate limit (0 = tắt).
# Web gọi API qua proxy của Next nên đặt 1 khi API chỉ nhận request từ web/hosting proxy.
TRUST_PROXY=0

# CORS: origin của web, phân tách bằng dấu phẩy
WEB_ORIGIN="http://localhost:3000"

# Tài khoản admin tạo bởi seed (đổi mật khẩu khi deploy)
SEED_ADMIN_EMAIL="admin@football.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# Giai đoạn 3 (upload ảnh)
CLOUDINARY_URL=""
